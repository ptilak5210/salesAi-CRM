# .env.example — Copy this to .env and fill in your values
# NEVER commit your real .env file to GitHub

# ──────────────────────────────────────────────
# Supabase Configuration
# ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vite (Frontend) — these are exposed in the browser bundle
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ──────────────────────────────────────────────
# n8n Integration
# ──────────────────────────────────────────────
# Secret API key used by n8n to authenticate with SalesAI backend
# Set the same value in your n8n Header Auth credential
N8N_API_KEY=salesai_n8n_secret_key_2024

# ──────────────────────────────────────────────
# Server Config
# ──────────────────────────────────────────────
PORT=3001

# ──────────────────────────────────────────────
# Google Gemini AI (Optional — for inline AI replies)
# ──────────────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key
